{
  "name": "polylinai",
  "version": "1.0.1",
  "description": "Lightweight, zero-dependency SVG Region of Interest (ROI) & Polyline drawing library for AI Computer Vision video feeds",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite demo",
    "build": "tsup",
    "build:demo": "vite build demo --outDir dist-demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "roi",
    "region-of-interest",
    "polyline",
    "polygon",
    "computer-vision",
    "yolo",
    "opencv",
    "object-counting",
    "tripwire",
    "video-feed",
    "cctv",
    "svg"
  ],
  "author": "Risyandi <hello@risyandi.com>",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
